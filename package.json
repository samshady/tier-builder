{
  "name": "tier-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test tests/quality.test.js",
    "preview": "vite preview",
    "deploy": "tsc -b && vite build && git add -f dist && TREE_ID=$(git write-tree --prefix=dist) && COMMIT_ID=$(git commit-tree $TREE_ID -m 'deploy: update gh-pages') && git push origin $COMMIT_ID:refs/heads/gh-pages --force && git reset HEAD dist"


  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.6",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.59.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
